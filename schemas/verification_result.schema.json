{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perspective-council.invalid/schemas/verification_result.schema.json",
  "title": "Non-voting conditional verification",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "enum": [
        "V01",
        "V02"
      ]
    },
    "role": {
      "enum": [
        "Fact Verifier",
        "Risk Auditor"
      ]
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "CONFIRMED",
              "REFUTED",
              "PARTIALLY_SUPPORTED",
              "UNRESOLVED"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "decision_impact": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "claim_id",
          "claim",
          "status",
          "rationale",
          "evidence_ids",
          "decision_impact",
          "limitations"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "review_result.schema.json#/$defs/evidence"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "agent_id",
    "role",
    "findings",
    "evidence",
    "limitations"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "agent_id": {
            "const": "V01"
          }
        }
      },
      "then": {
        "properties": {
          "role": {
            "const": "Fact Verifier"
          }
        }
      },
      "else": {
        "properties": {
          "role": {
            "const": "Risk Auditor"
          }
        }
      }
    }
  ]
}
