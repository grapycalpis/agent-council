{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agent_id": {
      "enum": [
        "pro",
        "con"
      ]
    },
    "phase": {
      "enum": [
        "opening",
        "rebuttal"
      ]
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "verified",
              "user_provided",
              "assumption",
              "speculation",
              "unverified"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification_note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "claim",
          "status",
          "source",
          "verification_note"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "verified"
                }
              }
            },
            "then": {
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^https?://[^ ]+"
                }
              }
            }
          }
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  },
  "required": [
    "agent_id",
    "phase",
    "arguments",
    "evidence",
    "assumptions",
    "uncertainties"
  ],
  "additionalProperties": false
}
