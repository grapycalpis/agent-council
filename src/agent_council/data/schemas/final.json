{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "vote": {
      "enum": [
        "SUPPORT",
        "OPPOSE",
        "CONDITIONAL",
        "ABSTAIN"
      ]
    },
    "reasoning": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "changed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "change_reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "important_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "verified",
              "user_provided",
              "assumption",
              "speculation",
              "unverified"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification_note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "claim",
          "status",
          "source",
          "verification_note"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "verified"
                }
              }
            },
            "then": {
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^https?://[^ ]+"
                }
              }
            }
          }
        ]
      }
    },
    "remaining_uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "confidence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "assessment": {
      "type": "object",
      "properties": {
        "feasibility": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "expected_value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "risk": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "evidence_quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "required": [
        "feasibility",
        "expected_value",
        "risk",
        "evidence_quality"
      ],
      "additionalProperties": false
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "critical_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "impact": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "likelihood": {
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          }
        },
        "required": [
          "description",
          "impact",
          "likelihood"
        ],
        "additionalProperties": false
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "reversal_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "disputed_assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assumption": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "enum": [
              "proposal",
              "own_initial",
              "opening.pro",
              "opening.con",
              "rebuttal.pro",
              "rebuttal.con"
            ]
          }
        },
        "required": [
          "assumption",
          "reason",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "enum": [
                "proposal",
                "own_initial",
                "opening.pro",
                "opening.con",
                "rebuttal.pro",
                "rebuttal.con"
              ]
            },
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "sources",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "agent_id",
    "vote",
    "reasoning",
    "changed",
    "change_reason",
    "important_evidence",
    "remaining_uncertainties",
    "confidence",
    "assessment",
    "assumptions",
    "evidence_gaps",
    "critical_risks",
    "experiments",
    "reversal_conditions",
    "disputed_assumptions",
    "contradictions"
  ],
  "additionalProperties": false
}
