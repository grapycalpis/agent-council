{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "context": {
      "type": "string"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "claim",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "description",
    "context",
    "goals",
    "constraints"
  ],
  "additionalProperties": false
}
